<Window x:Class="CG3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sharpGL="clr-namespace:SharpGL.WPF;assembly=SharpGL.WPF"
        xmlns:local="clr-namespace:CG3D"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        PreviewKeyDown="Window_KeyDown"
        PreviewKeyUp="Window_KeyUp"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">
        
        

    <Grid Background="#20242B">
        <sharpGL:OpenGLControl
            x:Name="OpenGLControl"
            Focusable="True"
            OpenGLInitialized="OpenGLControl_Initialized"
            OpenGLDraw="OpenGLControl_Draw"
            DrawFPS="True"
            Resized="OpenGLControl_Resized"
            MouseDown="OpenGLControl_MouseDown"
            MouseUp="OpenGLControl_MouseUp">
            
            <sharpGL:OpenGLControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Переключить освещение">
                        <MenuItem Header="Глобальное"
                        Click="ToggleGlobalLight"/>

                        <MenuItem Header="Точечное"
                        Click="TogglePointLight"/>
                    </MenuItem>
                    
                    <MenuItem Header="Изменить свойства материала объекта">
                        <MenuItem 
                            Header="Ambient"
                            Tag="0"
                            Click="ChangeRGBAObject"/>
                        <MenuItem 
                            Header="Diffuse"
                            Tag="1"
                            Click="ChangeRGBAObject"/>
                        <MenuItem 
                            Header="Specular"
                            Tag="2"
                            Click="ChangeRGBAObject"/>
                    </MenuItem>
                    
                    <MenuItem Header="Изменить свойства глобального источника света">
                        <MenuItem 
                            Header="Ambient"
                            Tag="0"
                            Click="ChangeRGBASource"/>
                        <MenuItem 
                            Header="Diffuse"
                            Tag="1"
                            Click="ChangeRGBASource"/>
                        <MenuItem 
                            Header="Specular"
                            Tag="2"
                            Click="ChangeRGBASource"/>
                    </MenuItem>
                    <MenuItem Header="Изменить свойства точечного источника света">
                        <MenuItem 
                            Header="Ambient"
                            Tag="0"
                            Click="ChangeRGBAPoint"/>
                        <MenuItem 
                            Header="Diffuse"
                            Tag="1"
                            Click="ChangeRGBAPoint"/>
                        <MenuItem 
                            Header="Specular"
                            Tag="2"
                            Click="ChangeRGBAPoint"/>
                    </MenuItem>
                    <MenuItem Header="Режим каркаса"
                        Click="ToggleWireframe"/>
                    <MenuItem Header="Отрисовка нормалей"
                        Click="ToggleNormals"/>
                </ContextMenu>
            </sharpGL:OpenGLControl.ContextMenu>
        </sharpGL:OpenGLControl>
    </Grid>
</Window>
